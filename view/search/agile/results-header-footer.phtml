<?php
/**
 * The results header and footer of the Agile search page: one right-aligned row of controls — the result count,
 * the per-page and sort selects, the list / grid toggle (icon labels) — the Southern Foodways arrangement (design
 * review I4, I5). The footer carries the paginator. Which parts appear, and where, is the search page's "results"
 * configuration (Advanced Search > Search page > Results).
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation|null $site
 * @var \AdvancedSearch\Api\Representation\SearchConfigRepresentation $searchConfig
 * @var \AdvancedSearch\Query $query
 * @var \AdvancedSearch\Response $response
 * @var \Omeka\Api\Representation\ItemSetRepresentation|null $itemSet
 * @var string $resultPart "header" or "footer"
 */

$plugins = $this->getHelperPluginManager();
$translate = $plugins->get('translate');
$translatePlural = $plugins->get('translatePlural');

// Default values of the module.
$displayParts = [
    'search_filters' => 'header',
    'active_facets' => 'none',
    'total_results' => 'header',
    'search_form_simple' => 'none',
    'search_form_quick' => 'none',
    'paginator' => 'footer',
    'per_page' => 'header',
    'sort' => 'header',
    'grid_list' => 'header',
    'grid_list_mode' => 'auto',
];
$displayParts = $searchConfig ? $searchConfig->setting('results', $displayParts) : $displayParts;
$displayParts = array_filter($displayParts, fn ($v) => in_array($v, [$resultPart, 'both']));

$paginationPerPages = isset($displayParts['per_page']) ? ($searchConfig->subSetting('results', 'per_page_list') ?: []) : [];
$sortFields = isset($displayParts['sort']) ? $searchConfig->subSetting('results', 'sort_list') : [];
$gridListMode = $searchConfig->subSetting('results', 'grid_list_mode', 'auto');
// An item set's page opens in list view (design review H1); a visitor's stored choice still wins (search.js).
if (!empty($itemSet) && !in_array($gridListMode, ['list_only', 'grid_only'])) {
    $gridListMode = 'list';
}
$multiMode = isset($displayParts['grid_list']) && !in_array($gridListMode, ['list_only', 'grid_only']);
$isHeader = $resultPart === 'header';
$totalResults = $response->getResourceTotalResults('items');
$hasControls = isset($displayParts['total_results']) || count($paginationPerPages) || count($sortFields) || $multiMode;
?>
<!-- RESULTS-HEADER-FOOTER BEGIN search/agile/results-header-footer -->
<?php if ($hasControls): ?>
<div class="search-results-controls">
    <?php if (isset($displayParts['total_results'])): ?>
    <div class="search-results-count-total"><?= sprintf($translatePlural('%s resource', '%s resources', $totalResults), $totalResults) ?></div>
    <?php endif; ?>

    <?php if (count($paginationPerPages)): ?>
    <?= $this->searchPaginationPerPageSelector($query, $paginationPerPages, true) ?>
    <?php endif; ?>

    <?php if (count($sortFields)): ?>
    <?= $this->searchSortSelector($query, $sortFields, ['as_url' => true, 'label' => $searchConfig->subSetting('results', 'label_sort')]) ?>
    <?php endif; ?>

    <?php if ($multiMode): ?>
    <div class="search-results-display">
        <?php // The active button is the configured default view ("auto" is grid, as in Advanced Search); its script
              // opens that view unless the visitor has chosen one before (localStorage). ?>
        <a class="search-view-type search-view-type-list<?= in_array($gridListMode, ['list', 'list_only']) ? ' active' : '' ?>" href="#" role="button" aria-pressed="<?= in_array($gridListMode, ['list', 'list_only']) ? 'true' : 'false' ?>"><?= $translate('List') ?></a>
        <a class="search-view-type search-view-type-grid<?= in_array($gridListMode, ['grid', 'grid_only', 'auto']) ? ' active' : '' ?>" href="#" role="button" aria-pressed="<?= in_array($gridListMode, ['grid', 'grid_only', 'auto']) ? 'true' : 'false' ?>"><?= $translate('Grid') ?></a>
    </div>
    <?php endif; ?>
</div>
<?php endif; ?>

<?php // Active facets, when the configuration puts them here (the search page also draws them as chips above the results). ?>
<?php if (isset($displayParts['active_facets']) && $activeFacets = $response->getActiveFacets()): ?>
    <?php $facetActives = $plugins->get('facetActives'); ?>
    <?= $facetActives(null, $activeFacets, $searchConfig->setting('facet', [])) ?>
<?php endif; ?>

<?php if (isset($displayParts['search_form_simple'])): ?>
<?= $searchConfig->renderForm(['variant' => 'simple', 'skip_form_action' => true]) ?>
<?php endif; ?>

<?php if (isset($displayParts['search_form_quick'])): ?>
<?= $searchConfig->renderForm(['variant' => 'quick', 'skip_form_action' => true]) ?>
<?php endif; ?>

<?php if (isset($displayParts['paginator']) && !$isHeader): ?>
<div class="search-results-count <?= isset($displayParts['total_results']) ? 'no-total-results' : '' ?>">
    <?php
    if ($itemSet && $site):
        // AdvancedSearch 3.4.64+ keeps the item set redirects in this one setting (the legacy aliases are gone).
        $redirectItemSets = $this->siteSetting('advancedsearch_item_sets_redirects', ['default' => 'browse']);
        $redirectItemSet = $redirectItemSets[$itemSet->id()] ?? $redirectItemSets['default'] ?? 'browse';
        echo $redirectItemSet === 'all'
            ? $this->paginationSearch('common/pagination', $response->getTotalResults(), $response->getCurrentPage(), $response->getPerPage())
            : $this->pagination('common/pagination');
    else:
        echo $this->pagination('common/pagination');
    endif;
    ?>
</div>
<?php endif; ?>
<!-- RESULTS-HEADER-FOOTER END search/agile/results-header-footer -->
