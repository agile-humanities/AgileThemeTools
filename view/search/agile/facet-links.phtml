<?php
/**
 * Link facet values (AgileThemeTools search page). See facet-checkboxes.phtml.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var string $name
 * @var array $facetValues With value, count, active, label and url when needed.
 * @var array $options
 */

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$displayCount = !empty($options['display_count']);
?>
<!-- TEMPLATE BEGIN: /search/agile/facet-links.phtml -->
<ul class="search-facet-items facet-links">
    <?php foreach ($facetValues as $facetValue):
        $facetClass = urlencode(strtolower(str_replace(' ', '-', (string) $facetValue['value'])));
    ?>
    <li class="facet-item <?= $facetClass ?> <?= $facetValue['active'] ? 'active selected' : 'inactive' ?>">
        <span>
            <a rel="nofollow" href="<?= $escapeAttr($facetValue['url']) ?>"><?= $escape($facetValue['label']) ?></a>
            <?php if ($displayCount): ?>(<span class="count"><?= $facetValue['count'] ?></span>)<?php endif; ?>
        </span>
    </li>
    <?php endforeach; ?>
</ul>
<!-- TEMPLATE END: /search/agile/facet-links.phtml -->
