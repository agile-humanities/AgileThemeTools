<?php
/**
 * The Agile Theme Tools search form (Search\AgileFormAdapter): Advanced Search's form object, laid out element by
 * element through the form-layout helper (View\Helper\FormLayout) instead of printed whole.
 *
 * Three parts, one <form>: the search bar (the "q" element with its own submit, outside the filter panel — the
 * Southern Foodways arrangement, design review I6), the filter panel (#advanced-search-form-wrapper: every other
 * element, inside a <details> disclosure that is closed unless the query carries a filter value), and the buttons,
 * which sit outside the collection so a theme can place them (submit first, then reset).
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \AdvancedSearch\Form\MainSearchForm $form
 * @var \AdvancedSearch\Api\Representation\SearchConfigRepresentation $searchConfig
 */
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$params = $this->params()->fromQuery() ?: [];
$form->setData($params)->prepare();
$formId = $form->getAttribute('id') ?: 'form-search';
$form->setAttribute('id', $formId);
// The composed form (stop14 form composition: rows of cells, an actions row, a validation summary).
$form->setAttribute('class', trim(($form->getAttribute('class') ?? '') . ' s14-form'));

$q = null;
if ($form->has('q')) {
    $q = $form->get('q');
    $form->remove('q');
    $q->setAttribute('class', trim(($q->getAttribute('class') ?? '') . ' search-bar-input'));
    if (!$q->getAttribute('placeholder')) {
        $q->setAttribute('placeholder', $translate('Search the collection'));
    }
    if (!$q->getAttribute('aria-label')) {
        $q->setAttribute('aria-label', $q->getAttribute('placeholder'));
    }
}

$reset = null;
$submit = null;
if ($form->has('form-reset')) {
    $reset = $form->get('form-reset');
    $form->remove('form-reset');
    $reset->setAttribute('class', trim(($reset->getAttribute('class') ?? '') . ' agile-button reset'));
}
if ($form->has('submit')) {
    $submit = $form->get('submit');
    $form->remove('submit');
    // The module's "search-submit button" classes are replaced: the theme library styles .search-submit as the
    // search box's own ghost button; this is the form's submit, with the search icon.
    $submit->setAttribute('class', 'agile-button submit-search');
}

// The disclosure opens when any filter element carries a value: a scalar other than the empty string, or, for the
// filter rows, a row with a value (a blank row still carries its joiner and type).
$hasValue = function ($value) use (&$hasValue): bool {
    if (is_array($value)) {
        foreach ($value as $v) {
            if ($hasValue($v)) {
                return true;
            }
        }
        return false;
    }
    return $value !== null && $value !== '';
};
$filtersOpen = false;
foreach ($form as $element) {
    $name = $element->getName();
    if (!isset($params[$name]) || in_array($name, ['csrf', 'submit', 'page', 'per_page', 'sort', 'sort_by', 'sort_order', 'limit', 'offset'], true)) {
        continue;
    }
    if ($name === 'filter' && is_array($params[$name])) {
        foreach ($params[$name] as $row) {
            if (is_array($row) && $hasValue($row['val'] ?? $row['value'] ?? null)) {
                $filtersOpen = true;
                break;
            }
        }
    } elseif ($hasValue($params[$name])) {
        $filtersOpen = true;
    }
    if ($filtersOpen) {
        break;
    }
}
?>
<!-- BEGIN search/agile/form -->
<?= $this->form()->openTag($form) ?>
<?php $form->removeAttribute('id'); // formLayout keeps element ids; the form's own id is on the tag ?>
<?php if ($q): ?>
<div class="search-bar agile-search-bar">
    <?= $this->formElement($q) ?>
    <button type="submit" class="search-submit" aria-label="<?= $escape($translate('Submit search')) ?>"></button>
</div>
<?php endif; ?>
<details class="advanced-search-filters"<?= $filtersOpen ? ' open' : '' ?>>
    <summary><?= $escape($translate('Advanced Search Filters')) ?></summary>
    <div id="advanced-search-form-wrapper">
        <div id="advanced-search-form" class="advanced-search-form agile-search-form">
            <?= $this->formLayout($form, ['compose' => true, 'max_cells' => 3]) ?>
            <div class="search-form-buttons form-actions">
                <?php if ($submit): ?>
                    <?= $this->formButton($submit) ?>
                <?php else: ?>
                    <button type="submit" name="submit" class="agile-button submit-search" value=""><?= $escape($translate('Submit')) ?></button>
                <?php endif; ?>
                <?= $reset ? $this->formButton($reset) : '' ?>
            </div>
        </div>
    </div>
</details>
<?= $this->form()->closeTag() ?>
<!-- END search/agile/form -->
