<?php
/**
 * Checkbox facet values (AgileThemeTools search page). Advanced Search prepares the values (label, count, active
 * state, url) and decides which are shown; this template only draws them. Each value's slug is a class on its
 * <li>, a hook for site scripts (ordering, styling); values start as .inactive and the search support script
 * reveals the configured number ("more" / "fewer options").
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var string $name
 * @var array $facetValues With value, count, active, label and url when needed.
 * @var array $options
 * @var array|null $tree For item sets tree or thesaurus.
 */

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$isFacetModeDirect = in_array($options['mode'] ?? null, ['link', 'js']);
$displayCount = !empty($options['display_count']);
$isTree = is_array($tree);
?>
<!-- BEGIN TEMPLATE search/agile/facet-checkboxes -->
<ul class="facet-items search-facet-items facet-checkboxes">
    <?php foreach ($facetValues as $facetValue):
        $escapedValue = $escapeAttr($facetValue['value']);
        $escapedId = $name . '[]' . $escapedValue;
        $label = $displayCount
            ? sprintf('<span>%s <span class="count">(%d)</span></span>', $escape($facetValue['label']), $facetValue['count'])
            : $escape($facetValue['label']);
        $treeVal = $isTree ? $tree[$facetValue['value']] ?? null : null;
        $treeValAttrs = $treeVal ? sprintf(' data-value="%s" data-parent="%s" data-level="%s"', $treeVal['id'], $treeVal['parent'], $treeVal['level']) : '';
        $facetClass = urlencode(strtolower(str_replace(' ', '-', (string) $facetValue['value'])));
    ?>
    <li class="facet-item <?= $facetClass ?> <?= $facetValue['active'] ? 'active' : 'inactive' ?>"<?= $treeValAttrs ?>>
        <input type="checkbox" name="<?= "facet[$name][]" ?>" id="<?= $escapedId ?>" value="<?= $escapedValue ?>"<?= $isFacetModeDirect ? ' data-url="' . $escapeAttr($facetValue['url']) . '"' : '' ?><?= $facetValue['active'] ? ' checked="checked"' : '' ?>/>
        <label for="<?= $escapedId ?>"><?= $label ?></label>
    </li>
    <?php endforeach; ?>
</ul>
<!-- END TEMPLATE search/agile/facet-checkboxes -->
