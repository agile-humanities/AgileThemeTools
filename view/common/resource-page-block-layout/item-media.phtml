<?php

/** @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource */
$resourceMedia = $resource->media();
$partial = $this->plugin('partial');
$options = ['hasVtt'=>$hasVtt];


/** @var \Omeka\Api\Representation\MediaRepresentation $primaryMedia */

?>
<!-- TEMPLATE BEGIN common/resource-page-block-layout/item-media.phtml -->
<?php if ($resourceMedia): ?>
  <div class="item-viewer media-embeds <?= $usePrimary ? 'primary-media' : '' ?>  <?= $hasVtt ? 'has-vtt' : '' ?>">

    <?php
      if ($useMirador):
        /** @var \Mirador\View\Helper\Mirador $mirador */
        $mirador = $this->plugin('mirador');
        echo $mirador($resource);

      elseif ($useUV):
        $uv = $this->plugin('universalViewer');
        echo $uv($resource);
      elseif ($usePrimary): ?>
        <?= $primaryMedia->render(); ?>
      <?php else: ?>
        <?php foreach ($resourceMedia as $media): ?>
          <?php if ($hasVtt) {
            $options['label'] = sprintf("Transcript (%s)",$media->extension());
          }
          ?>
          <?= $media->render($options); ?>
        <?php endforeach; ?>
      <?php endif; ?>
  </div>
<?php endif; ?>

<!-- TEMPLATE END common/resource-page-block-layout/item-media.phtml -->
